# Workout Reminder App AI configuration
# API Key 只允许配置在后端环境变量中，不要写入前端、localStorage 或 git 提交记录。

# 推荐变量名
WORKOUT_AI_API_KEY=
WORKOUT_AI_BASE_URL=https://api.deepseek.com/v1
WORKOUT_AI_MODEL=deepseek-v4-flash

# 兼容变量名（后端会按 WORKOUT_* → OPENAI_* → DEEPSEEK_* → WUAPI_* 顺序读取）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

WUAPI_API_KEY=
WUAPI_BASE_URL=
WUAPI_MODEL=
